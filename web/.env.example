# SupplyChainIQ Web -- server-side Snowflake connectivity.
# Copy to .env.local (never commit .env.local) and fill in real values there.
# Every variable here is read ONLY on the server (Next.js server components,
# route handlers, lib/snowflake). Never prefix Snowflake config with
# NEXT_PUBLIC_ -- that would ship it to the browser bundle.

# --- Core connection ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SUPPLYCHAINIQ_DB
SNOWFLAKE_SCHEMA=PUBLIC

# --- Authentication (choose ONE strategy) ---
# Preferred for production: key-pair (JWT) authentication.
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# For local development only, if your account/policy still allows it.
# Prefer key-pair auth even locally where possible.
# SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE
# SNOWFLAKE_PASSWORD=

# --- Application safety ---
# Set to "true" to run the app in read-only public-demo mode: all mutation
# endpoints (approval review, dispatch) reject requests server-side,
# regardless of what the UI shows.
PUBLIC_DEMO_MODE=false

# Restricted-caller identity used for identity-sensitive writes (approval
# review). This role/user must be distinct from any broadly privileged
# service role -- do not use ACCOUNTADMIN here.
SNOWFLAKE_CALLER_ROLE=
